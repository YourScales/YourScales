{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "portal.yourscales.com"
        }
      ],
      "destination": "/portal/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "portal.yourscales.com"
        }
      ],
      "destination": "/portal/index.html"
    }
  ]
}
